TARGET TaskAdmin.exe
TARGETTYPE exe
UID 0x100039CE 0xA0000D16

// No system capabilities: a self-signed SISX cannot be granted PowerMgmt on an
// unpatched phone, and the loader then refuses to start the EXE at all.
// Kill commands stay in the menu but report the missing capability instead of
// panicking; EndTask works without it.
CAPABILITY LocalServices ReadUserData WriteUserData

SOURCEPATH .
SOURCE TaskAdmin.cpp

SOURCEPATH .
START RESOURCE TaskAdmin.rss
HEADER
TARGETPATH /resource/apps
END

SOURCEPATH .
START RESOURCE TaskAdmin_reg.rss
TARGETPATH /private/10003a3f/import/apps
END

SYSTEMINCLUDE \epoc32\include

LIBRARY euser.lib
LIBRARY efsrv.lib
LIBRARY apparc.lib
LIBRARY cone.lib
LIBRARY ws32.lib
LIBRARY apgrfx.lib
LIBRARY eikcore.lib
LIBRARY eikdlg.lib
LIBRARY eikcoctl.lib
LIBRARY eiksrv.lib
LIBRARY avkon.lib
LIBRARY aknnotify.lib
LIBRARY bafl.lib
